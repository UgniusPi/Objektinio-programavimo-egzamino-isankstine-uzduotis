# Doxyfile minimal configuration for this project

PROJECT_NAME           = "Objektinio-programavimo-uzduotis"
OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

# Source
INPUT                  = .
FILE_PATTERNS          = *.cpp *.h
RECURSIVE              = YES
EXCLUDE                = tests
EXCLUDE_PATTERNS       = */tests/*

# Extract
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO

# Output
GENERATE_HTML          = YES
GENERATE_LATEX         = YES
GENERATE_XML           = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO

# Extras
INLINE_SOURCES         = YES
SOURCE_BROWSER         = YES
GENERATE_TREEVIEW      = YES
QUIET                  = NO
WARNINGS               = YES
